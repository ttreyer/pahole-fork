#!/usr/bin/poke -L
!#

type II_location_op = struct {
  uint<8> ty;
  union {
    byte[0] nil: ty == 0;
    int<8> signed_const_1: ty == 1;
    int<16> signed_const_2: ty == 2;
    int<32> signed_const_4: ty == 3;
    int<64> signed_const_8: ty == 4;
    uint<8> unsigned_const_1: ty == 5;
    uint<16> unsigned_const_2: ty == 6;
    uint<32> unsigned_const_4: ty == 7;
    uint<64> unsigned_const_8: ty == 8;
    uint<8> register: ty == 9;
    struct {
      uint<8> reg;
      uint<32> offset;
    } addr_register_offset: ty == 10;
  } value;
};

type II_inline_instance = struct {
  uint<64> insn_offset;
  uint<32> type_id;
  uint<16> param_count;
  offset<uint<32>, B>[param_count] param_offsets;
};

type II_Header = struct {
  uint<16> magic == 0xeb9f;
  uint<8> version;
  uint<8> flags;
  uint<32> header_size;
  offset<uint<32>, B> inline_info_offset;
  offset<uint<32>, B> inline_info_size;
  offset<uint<32>, B> location_offset;
  offset<uint<32>, B> location_size;
};

type FA_Header = struct {
  uint<16> magic == 0xeb9f;
  uint<8> version;
  uint<8> flags;
  uint<32> header_size;
  offset<uint<32>, B> type_offset;
  offset<uint<32>, B> type_size;
  offset<uint<32>, B> string_offset;
  offset<uint<32>, B> string_size;
  offset<uint<32>, B> location_offset;
  offset<uint<32>, B> location_size;
};

type funcsec_info = struct {
  uint<32> type_id;
  uint<32> addr;
  uint<32> loc_off;
};

type BTF_Type = struct {
  offset<uint<32>, B> name_off;
  uint<1> kind_flag;
  uint<2> _unused1;
  uint<5> kind;
  uint<8> _unused2;
  uint<16> vlen;
  uint<32> size;

  union {
    funcsec_info[vlen] funcsec: kind == 20;
    byte[0] _unused3: kind != 20;
  };
};

type FA = struct {
  FA_Header hdr;

};

type II = struct {
  II_Header hdr;
  II_inline_instance[hdr.inline_info_size] inline_instances @ hdr.inline_info_offset;
  II_location_op[hdr.location_size] locations @ hdr.location_offset;
};
